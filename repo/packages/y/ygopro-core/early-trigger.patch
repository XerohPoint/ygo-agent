+// Historical scripts may explicitly remove the default phase activation limit.
+// Call after RegisterEffect, which otherwise installs that default.
+int32 scriptlib::effect_remove_count_limit(lua_State *L) {
+	check_param_count(L, 1);
+	check_param(L, PARAM_TYPE_EFFECT, 1);
+	effect* peffect = *(effect**) lua_touserdata(L, 1);
+	peffect->flag[0] &= ~EFFECT_FLAG_COUNT_LIMIT;
+	peffect->count_limit = 0;
+	peffect->count_limit_max = 0;
+	peffect->count_code = 0;
+	return 0;
